# Copy to .env and fill in. Never commit the real .env.
# The app reads these from the process environment (export them, or load this
# file with your process manager / `set -a; . ./.env; set +a`).
#
# On Vercel, don't use a .env file at all: set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables), or with `vercel env add`.
# DATABASE_URL and BLOB_READ_WRITE_TOKEN in particular are injected for you
# automatically once you connect a Neon (or other Postgres) database and a
# Blob store to the project — see the README's "Deploying to Vercel" section.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_TIME_ZONE=Africa/Kigali
# Only needed if you put a custom domain in front of Vercel; *.vercel.app is
# already trusted for CSRF automatically (see nit_platform/settings.py).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Database — leave unset for local development (falls back to SQLite).
# In production this must be a real Postgres database; Neon is the reference
# target. Use the *pooled* connection string Neon gives you (the one with
# "-pooler" in the hostname) — Vercel Functions are short-lived and can run
# many at once, and Neon's pooler is built for exactly that.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Traditional always-on server only (not Vercel) — how long to keep a
# database connection open and reuse it, in seconds. Leave unset on Vercel
# (defaults to 0: a fresh, pooled connection per request).
# DB_CONN_MAX_AGE=600

# File storage — leave unset for local development (uploads are written to
# media/ and private_media/ on disk). On Vercel this MUST be set, or every
# uploaded module note, resource and lesson file will silently disappear —
# Vercel's filesystem doesn't persist writes between requests. Connect a
# Blob store from the Vercel dashboard (Storage -> Blob -> Connect to
# Project) and this is injected automatically; you shouldn't normally need
# to set it by hand.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Module notes: PDF/HTML files uploaded by Trainers are kept OUTSIDE the public
# media folder. Back this folder up together with the database. (Ignored when
# BLOB_READ_WRITE_TOKEN is set — notes go to Blob storage instead.)
# PRIVATE_MEDIA_ROOT=/var/lib/nit/private_media
MAX_NOTE_SIZE_MB=25
MAX_UPLOAD_SIZE_MB=8

# AI study assistant — Groq is the platform's only AI provider. Leave
# GROQ_API_KEY empty to switch AI features off entirely; the panel on every
# lesson explains this plainly instead of erroring. Get a key from
# https://console.groq.com/keys.
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for the current list of
# supported models if you want to change this.
GROQ_MODEL=llama-3.3-70b-versatile
